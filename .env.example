ESTABELECIMENTO_PADRAO_NOME=Menino dos Sonhos
BASE_URL=http://localhost:5000
HOST=0.0.0.0
PORT=5000
FLASK_DEBUG=false
SESSION_COOKIE_SECURE=false
MERCADOPAGO_WEBHOOK_SECRET=
# Opcional: chave Fernet usada para cifrar as credenciais salvas pelo painel.
# Se ficar vazia, uma chave e derivada da SECRET_KEY.
CONFIG_ENCRYPTION_KEY=
# Licenca: mantenha esta chave somente com voce, fornecedor do sistema.
# Gere uma com 48 ou mais caracteres aleatorios. Ative a validacao depois
# de emitir o primeiro certificado para a instalacao.
LICENSE_SIGNING_KEY=
LICENSE_ENFORCEMENT=false
WHATSAPP_EMPRESA=5571992843791
LOGIN_MAX_TENTATIVAS=5
LOGIN_JANELA_SEGUNDOS=900
# Recuperacao de senha por e-mail (SMTP). Nunca versione a senha SMTP.
PASSWORD_RESET_TTL_MINUTES=15
PASSWORD_RESET_MAX_TENTATIVAS=5
PASSWORD_RESET_MAX_SOLICITACOES=3
PASSWORD_RESET_JANELA_SEGUNDOS=900
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
