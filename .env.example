SECRET_KEY=troque-por-uma-chave-aleatoria
MERCADOPAGO_PUBLIC_KEY=APP_USR-sua-chave-publica
MERCADOPAGO_ACCESS_TOKEN=TEST-seu-token-de-teste
# Opcional: credenciais especificas da maquininha Point (venda presencial).
MERCADOPAGO_POINT_ACCESS_TOKEN=
MERCADOPAGO_POINT_TERMINAL_ID=
