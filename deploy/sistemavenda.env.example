# Copie para /etc/sistemavenda/sistemavenda.env. Nao versione este arquivo.
SECRET_KEY=gere-uma-chave-longa-e-aleatoria
MERCADOPAGO_PUBLIC_KEY=APP_USR-sua-chave-publica-de-producao
MERCADOPAGO_ACCESS_TOKEN=APP_USR-seu-access-token-de-producao
MERCADOPAGO_WEBHOOK_SECRET=assinatura-secreta-gerada-no-painel-mercado-pago
# Use a mesma chave, secreta e exclusiva, no seu aplicativo local privado de
# certificados. Nunca envie esta chave ao restaurante.
LICENSE_SIGNING_KEY=gere-uma-chave-com-pelo-menos-48-caracteres
LICENSE_ENFORCEMENT=true
ESTABELECIMENTO_PADRAO_SLUG=menino-dos-sonhos
ESTABELECIMENTO_PADRAO_NOME=Menino dos Sonhos
WHATSAPP_EMPRESA=5571992843791
BASE_URL=https://meninodossonhos.com.br
DATABASE=/var/lib/sistemavenda/database.db
HOST=127.0.0.1
PORT=8000
FLASK_DEBUG=false
SESSION_COOKIE_SECURE=true
LOGIN_MAX_TENTATIVAS=5
LOGIN_JANELA_SEGUNDOS=900
# Recuperacao de senha por e-mail (SMTP). Use senha de aplicativo quando o
# provedor exigir; nunca use nem versione a senha normal da sua caixa postal.
PASSWORD_RESET_TTL_MINUTES=15
PASSWORD_RESET_MAX_TENTATIVAS=5
PASSWORD_RESET_MAX_SOLICITACOES=3
PASSWORD_RESET_JANELA_SEGUNDOS=900
SMTP_HOST=smtp.seu-provedor.com
SMTP_PORT=587
SMTP_USERNAME=nao-versione-este-usuario
SMTP_PASSWORD=nao-versione-esta-senha
SMTP_FROM=AG Delivery <suporte@seu-dominio.com>
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SUPPORT_WHATSAPP=5571992843791
